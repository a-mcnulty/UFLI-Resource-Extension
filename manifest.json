{
  "manifest_version": 3,
  "name": "UFLI Foundations Lesson Companion",
  "version": "1.0.0",
  "description": "Every UFLI Foundations lesson resource plus a step timer for the 30-minute Day 1 / Day 2 lesson plan.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "UFLI Lesson Companion"
  },
  "permissions": ["storage", "sidePanel", "alarms", "notifications"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  }
}
